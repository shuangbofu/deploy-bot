{
  "descriptor": {
    "pluginId": "fullstack-deployment",
    "displayName": "前后端一体项目",
    "category": "一体化项目",
    "templateTypes": ["springboot_frontend"],
    "composite": true,
    "builtin": true,
    "provider": "deploy-bot",
    "description": "适用于前端静态资源构建后与后端服务一起发布的一体化项目。"
  },
  "bannerResource": "/plugin-banner/fullstack.txt",
  "runtimeRequirement": {
    "buildRuntimeTypes": ["NODE", "JAVA", "MAVEN"],
    "targetRuntimeTypes": ["JAVA"]
  },
  "variableDefinitions": [
    {
      "key": "frontendDir",
      "label": "前端目录",
      "description": "前端工程在仓库中的相对目录。",
      "required": true,
      "secret": false,
      "pipelineInput": false,
      "defaultValue": "frontend"
    },
    {
      "key": "backendStaticDir",
      "label": "后端静态目录",
      "description": "承接前端静态资源的后端目录。",
      "required": true,
      "secret": false,
      "pipelineInput": false,
      "defaultValue": "backend/src/main/resources/static"
    },
    {
      "key": "backendBuildWorkDir",
      "label": "后端构建目录",
      "description": "执行后端 Maven 构建的仓库子目录。",
      "required": true,
      "secret": false,
      "pipelineInput": false,
      "defaultValue": "."
    },
    {
      "key": "frontendBuildCommand",
      "label": "前端构建命令",
      "description": "用于执行前端依赖安装和构建。",
      "required": true,
      "secret": false,
      "pipelineInput": false,
      "defaultValue": "npm ci --cache \"$BUILD_WORKSPACE_ROOT/caches/npm\" --prefer-offline && npm run build",
      "binding": {
        "scope": "COMMAND_SLOT",
        "key": "BUILD_COMMAND"
      }
    },
    {
      "key": "backendBuildCommand",
      "label": "后端构建命令",
      "description": "用于执行后端 Maven 构建。",
      "required": true,
      "secret": false,
      "pipelineInput": false,
      "defaultValue": "mvn -U clean package -DskipTests",
      "mutationRuleIds": ["springboot.build.maven-settings"],
      "binding": {
        "scope": "COMMAND_SLOT",
        "key": "BACKEND_BUILD_COMMAND"
      }
    }
  ],
  "builtinTemplates": [
    {
      "templateKey": "springboot-frontend-default",
      "name": "Spring Boot 前后端一体部署",
      "description": "在本机完成前端构建与后端打包，再把 Jar 发布到目标主机或本机目录。",
      "templateType": "springboot_frontend",
      "buildScriptResource": "/scripts/fullstack/build.sh",
      "deployScriptResource": "/scripts/fullstack/deploy.sh",
      "variablesSchema": "[]",
      "monitorProcess": true
    }
  ]
}
