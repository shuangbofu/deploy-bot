#!/usr/bin/env bash
set -euo pipefail

SOURCE="${BASH_SOURCE[0]}"
while [[ -L "$SOURCE" ]]; do
  SOURCE_DIR="$(cd "$(dirname "$SOURCE")" && pwd)"
  TARGET="$(readlink "$SOURCE")"
  if [[ "$TARGET" == /* ]]; then
    SOURCE="$TARGET"
  else
    SOURCE="$SOURCE_DIR/$TARGET"
  fi
done

SCRIPT_DIR="$(cd "$(dirname "$SOURCE")" && pwd)"
CLI_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
JAR_PATH="$CLI_ROOT/target/deploy-bot-cli-0.0.1-SNAPSHOT.jar"

if [[ ! -f "$JAR_PATH" ]]; then
  echo "Deploy Bot CLI jar not found: $JAR_PATH" >&2
  echo "Run: mvn -pl cli -am -DskipTests package" >&2
  exit 1
fi

exec java -jar "$JAR_PATH" "$@"
